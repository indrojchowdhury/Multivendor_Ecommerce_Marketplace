SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SSLCommerz sandbox credentials from your SSLCommerz sandbox account.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=True

# Public HTTPS backend origin, without the /api/... path.
SSLCOMMERZ_CALLBACK_BASE_URL=
# Public HTTPS backend URL for the SSLCommerz IPN callback.
# Set to https://<public-backend-host>/api/orders/payments/ipn/
SSLCOMMERZ_IPN_URL=
FRONTEND_URL=http://localhost:5173
